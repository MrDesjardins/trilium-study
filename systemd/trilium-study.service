[Unit]
Description=Trilium Study Platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/.venv/bin/python -m app.serve
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
